#!/usr/bin/env bash
#
# Copyright (c) 2026 NostrHost Contributors
#
# Regenerate Caddy per-domain config snippets (regenconf category: caddy).
#
# The real web routing is reconciled through the Caddy admin API (native
# web.route resources and nostrhost-domain:<domain> sites); this category only
# maintains a tracked per-domain snippet under /etc/caddy/conf.d so regenconf
# can detect manual modifications and domain add/remove can re-render it,
# mirroring the retired 15-nginx category.

set -e
source /usr/share/yunohost/helpers

do_init_regen() {
    exit 0
}

do_pre_regen() {
    pending_dir=$1
    caddy_dir="${pending_dir}/etc/caddy"
    mkdir -p "$caddy_dir/conf.d"
    exit 0
}

do_regen() {
    pending_dir=$1
    caddy_dir="${pending_dir}/etc/caddy"
    mkdir -p "$caddy_dir/conf.d"
    cd /usr/share/yunohost/conf/caddy
    for domain in $(yunohost domain list --output-as json 2>/dev/null | jq -r '.domains[]'); do
        [ -n "$domain" ] || continue
        ynh_render_template "caddy_domain.conf" "${caddy_dir}/conf.d/${domain}.conf" \
            --var domain="$domain"
    done
    exit 0
}