#!/usr/bin/env python3
"""nostr-operationsd — operation executor daemon.

Subscribes to the operation chain (kinds 2200–2204) and capability grants
(kind 31100) on the local control relay and executes authorised, approved
requests against the safe read-only tool registry, publishing execution
started (2203) and result (2204) events as the server key.

Run as root. Config via /etc/nostrhost/operator.toml or NOSTRHOST_* env vars.
"""

from __future__ import annotations

import os as _os
import sys as _sys
from pathlib import Path as _Path

# Prefer the bundled runtime venv: the runtime's wheels (coincurve, ...) are
# only guaranteed inside /opt/nostrhost/venv; the system python is a fallback
# for nodes where the runtime has not been installed yet.
_VENV_PY = _Path("/opt/nostrhost/venv/bin/python3")
if _VENV_PY.is_file() and _os.path.realpath(_sys.executable) != _os.path.realpath(str(_VENV_PY)):
    _os.execv(str(_VENV_PY), [str(_VENV_PY), _sys.argv[0]] + _sys.argv[1:])


import sys

from yunohost.nostr_operationsd import run

if __name__ == "__main__":
    sys.exit(run())