#!/usr/bin/env python3
"""nostr-api — native HTTP API server (NIP-98 authenticated).

Serves the native NostrHost operations (see nostrhost.api).  Admins are the
operator pubkey (from config) and any --admin-pubkey values; requests must
carry a valid NIP-98 Authorization header from a linked admin identity.

Usage:
    nostr-api [--host 127.0.0.1] [--port 8190] [--admin-pubkey HEX ...]
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

try:  # installed layout: yunohost is a real package
    import yunohost  # noqa: F401
except ImportError:  # source-tree layout: alias src/ as the yunohost package
    _src = Path(__file__).resolve().parent.parent / "src"
    if _src.is_dir():
        import types

        _pkg = types.ModuleType("yunohost")
        _pkg.__path__ = [str(_src)]  # type: ignore[attr-defined]
        sys.modules["yunohost"] = _pkg

from nostrhost import api


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="nostr-api", description="Native NostrHost HTTP API")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8190)
    parser.add_argument("--admin-pubkey", action="append", default=[], help="admin pubkey (64-hex, repeatable)")
    parser.add_argument("--operator-pubkey", default=None, help="operator pubkey (64-hex)")
    args = parser.parse_args(argv)

    api.run(
        host=args.host,
        port=args.port,
        admin_pubkeys=tuple(args.admin_pubkey),
        operator_pubkey=args.operator_pubkey,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())