#!/usr/bin/env python3
"""nostrhost-bootstrap — establish the node's identity (bootstrap action).

On a fresh server there is no operator yet: nothing can act on the node's
behalf and the daemons refuse to start. This root-only, local, high-trust
action provisions the three roles of the hardened identity model:

  server_sk   — the server's own machine key (signs execution events 2203/2204)
  operator_sk — the primary admin key (signs approvals, grants, identity defs)
  admins      — admin pubkeys the projector/executor accept events from
  notice_sk   — the portal's dedicated low-privilege key (writes 2206 login
                notices only; the portal-api service must not hold root keys)

It writes /etc/nostrhost/operator.toml (0600), /etc/nostrhost/portal.toml
(0640, group ynh-portal) and, optionally, a relay config carrying
operator_pubkey + server_pubkey + notice_pubkey so all three are allowlisted
writers on the control plane. Bootstrap is the boundary between the
"bootstrap" phase (local authority) and "post-bootstrap" phase (authority
flows through the configured admins via signed events).

  nostrhost-bootstrap                       # generate server + operator keys
  nostrhost-bootstrap --operator-sk HEX     # import an existing operator key
  nostrhost-bootstrap --status              # show current bootstrap state
  nostrhost-bootstrap --write-relay PATH    # also write a relay config
  nostrhost-bootstrap --force               # overwrite an existing config
"""

from __future__ import annotations

import argparse
import os
import secrets
import sys
import tomllib
from pathlib import Path

DEFAULT_RELAY = "ws://127.0.0.1:4848"
OPERATOR_CONFIG = "/etc/nostrhost/operator.toml"
RELAY_KINDS = [2200, 2201, 2202, 2203, 2204, 2206, 31100, 31102, 30617]

CONTROL_KIND_HELP = """
Once the relay is running, both pubkeys must be allowlisted writers on it:
set relay operator_pubkey = <operator npub/hex> and server_pubkey = <server
npub/hex> (the bootstrap --write-relay output does this for you)."""


def _gen_sk() -> str:
    return secrets.token_bytes(32).hex()


def _pubkey(sk: str) -> str:
    from coincurve import PublicKeyXOnly

    return PublicKeyXOnly.from_secret(bytes.fromhex(sk)).format().hex()


def _npub(pk: str) -> str:
    from nostrhost_auth.identity.npub import hex_to_npub

    return hex_to_npub(pk)


def _is_hex64(s: str) -> bool:
    return len(s) == 64 and all(c in "0123456789abcdefABCDEF" for c in s)


def _config_path() -> Path:
    return Path(os.environ.get("NOSTRHOST_OPERATOR_CONFIG", OPERATOR_CONFIG))


def _read(path: Path) -> dict:
    if not path.exists():
        return {}
    with path.open("rb") as fh:
        return tomllib.load(fh)


def _print_keys(server_sk: str, operator_sk: str) -> None:
    server_pk, operator_pk = _pubkey(server_sk), _pubkey(operator_sk)
    print("server npub :", _npub(server_pk), f"({server_pk})")
    print("operator npub:", _npub(operator_pk), f"({operator_pk})")
    print(CONTROL_KIND_HELP)


def cmd_status(_args) -> int:
    conf = _read(_config_path())
    if not conf.get("operator_sk"):
        print(f"not bootstrapped: no operator_sk in {OPERATOR_CONFIG}")
        print("run `nostrhost-bootstrap` (root) to generate the server + operator keys.")
        return 0
    from yunohost.nostr_identity import is_bootstrapped

    print(f"bootstrapped: {is_bootstrapped()}")
    if conf.get("server_sk"):
        _print_keys(conf["server_sk"], conf["operator_sk"])
    else:
        print("operator npub:", _npub(_pubkey(conf["operator_sk"])), f"({_pubkey(conf['operator_sk'])})")
        print("legacy single-key config (no distinct server key) — re-run with --force to harden.")
    if conf.get("admins"):
        print("admins:", ", ".join(_npub(a) if len(a) == 64 else a for a in conf["admins"]))
    return 0


def cmd_bootstrap(args) -> int:
    if os.geteuid() != 0:
        print("error: nostrhost-bootstrap must be run as root (writes /etc/nostrhost/)", file=sys.stderr)
        return 1

    path = _config_path()
    existing = _read(path)
    if existing.get("operator_sk") and not args.force:
        print(f"error: {path} already has an operator key; pass --force to regenerate", file=sys.stderr)
        return 1

    server_sk = args.server_sk or _gen_sk()
    operator_sk = args.operator_sk or _gen_sk()
    notice_sk = args.notice_sk or _gen_sk()
    for name, sk in (
        ("--server-sk", server_sk),
        ("--operator-sk", operator_sk),
        ("--notice-sk", notice_sk),
    ):
        if not _is_hex64(sk):
            print(f"error: {name} must be a 64-char hex secret key", file=sys.stderr)
            return 1

    operator_pk = _pubkey(operator_sk)
    admins = [a.strip() for a in (args.admins or "").split(",") if a.strip()]
    if not admins:
        admins = [operator_pk]

    path.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# nostrhost node identity (root-only). Generated by nostrhost-bootstrap.",
        "# server_sk = server machine key (signs execution events 2203/2204)",
        "# operator_sk = primary admin (signs approvals, grants, identity defs)",
        f'server_sk = "{server_sk}"',
        f'operator_sk = "{operator_sk}"',
        f'control_relay = "{args.relay}"',
        'admins = ["' + '", "'.join(admins) + '"]',
    ]
    tmp = path.with_suffix(".toml.tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    os.chmod(path, 0o600)

    # The portal's dedicated notice key (portal-api runs as the low-privilege
    # ynh-portal user and must not hold the root-only keys above). Written
    # group-readable to ynh-portal so login notices can be signed + published.
    notice_path = Path(os.environ.get("NOSTRHOST_NOTICE_CONFIG", "/etc/nostrhost/portal.toml"))
    notice_path.parent.mkdir(parents=True, exist_ok=True)
    notice_tmp = notice_path.with_suffix(".toml.tmp")
    notice_tmp.write_text(
        "# nostrhost portal notice key (ynh-portal). "
        "Generated by nostrhost-bootstrap.\n"
        f'notice_sk = "{notice_sk}"\n'
        f'control_relay = "{args.relay}"\n'
    )
    os.chmod(notice_tmp, 0o640)
    os.replace(notice_tmp, notice_path)
    os.chmod(notice_path, 0o640)
    try:
        import pwd

        portal_uid = pwd.getpwnam("ynh-portal").pw_uid
        os.chown(notice_path, 0, portal_uid)
    except (KeyError, ImportError):
        pass  # no ynh-portal user yet (pre-install): the notice stays a no-op

    print(f"bootstrapped {path}")
    print(f"portal notice key written: {notice_path}")
    _print_keys(server_sk, operator_sk)

    if args.write_relay:
        relay_path = Path(args.write_relay)
        relay_path.parent.mkdir(parents=True, exist_ok=True)
        server_pk = _pubkey(server_sk)
        notice_pk = _pubkey(notice_sk)
        relay = [
            'listen_host = "127.0.0.1"',
            "listen_port = 4848",
            'name = "nostrhost"',
            'description = "NostrHost local control plane"',
            f'operator_pubkey = "{operator_pk}"',
            f'server_pubkey = "{server_pk}"',
            f'notice_pubkey = "{notice_pk}"',
            'allowlist_mode = true',
            "require_auth_kinds = []",
            "allowed_kinds = [" + ", ".join(str(k) for k in RELAY_KINDS) + "]",
            "max_content_length = 100000",
            'events_db_path = "/var/lib/nostrhost/events.db"',
            'policy_db_path = "/var/lib/nostrhost/policy.db"',
        ]
        relay_path.write_text("\n".join(relay) + "\n")
        print(f"relay config written: {relay_path}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="nostrhost-bootstrap")
    parser.add_argument("--server-sk", default=None, help="import an existing server key (64-hex)")
    parser.add_argument("--operator-sk", default=None, help="import an existing operator key (64-hex)")
    parser.add_argument("--notice-sk", default=None, help="import an existing portal notice key (64-hex)")
    parser.add_argument("--admins", default=None, help="comma-separated admin pubkeys (defaults to operator)")
    parser.add_argument("--relay", default=DEFAULT_RELAY, help="control relay URL")
    parser.add_argument("--write-relay", default=None, help="also write a relay config to this path")
    parser.add_argument("--force", action="store_true", help="overwrite an existing bootstrapped config")
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("status", help="show current bootstrap state")

    args = parser.parse_args(argv)
    if args.command == "status":
        return cmd_status(args)
    return cmd_bootstrap(args)


if __name__ == "__main__":
    sys.exit(main())