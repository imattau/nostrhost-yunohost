#!/usr/bin/env python3
"""nostr-signerd — signer bridge daemon.

Subscribes to parked-approval notices (kind 2210, class ``approval``) on the
local control relay and pushes the unsigned kind-2201 approval to every
registered administrator remote signer over NIP-46, publishing the signed
approval the signer returns.

Run as root. Config via /etc/nostrhost/operator.toml, signer targets in
/etc/nostrhost/signer_targets.json, or NOSTRHOST_* env vars.
"""

from __future__ import annotations

import os as _os
import sys as _sys
from pathlib import Path as _Path

# Prefer the bundled runtime venv: the runtime's wheels (nostr-sdk, ...) are
# only guaranteed inside /opt/nostrhost/venv; the system python is a fallback
# for nodes where the runtime has not been installed yet.
_VENV_PY = _Path("/opt/nostrhost/venv/bin/python3")
if _VENV_PY.is_file() and _os.path.realpath(_sys.executable) != _os.path.realpath(str(_VENV_PY)):
    _os.execv(str(_VENV_PY), [str(_VENV_PY), _sys.argv[0]] + _sys.argv[1:])


from yunohost.nostr_signerd import run

if __name__ == "__main__":
    run()
