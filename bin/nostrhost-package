#!/usr/bin/env python3

import os as _os
import sys as _sys
from pathlib import Path as _Path

# Prefer the bundled runtime venv: the runtime's wheels (nostr-sdk, ...) are
# only guaranteed inside /opt/nostrhost/venv; the system python is a fallback
# for nodes where the runtime has not been installed yet. The venv's python
# binary is a symlink to the system interpreter, so detect it via sys.prefix
# rather than the executable path.
_VENV = _Path("/opt/nostrhost/venv")
if (_VENV / "bin/python3").is_file() and _Path(_sys.prefix) != _VENV:
    _os.execv(str(_VENV / "bin/python3"), [str(_VENV / "bin/python3"), _sys.argv[0]] + _sys.argv[1:])

"""Human- and agent-facing native package authoring CLI.

Delegates to :mod:`nostrhost.package_authoring` (also importable as
``yunohost.nostrhost.package_authoring`` when installed under the yunohost
package), which implements ``schema`` / ``init`` / ``validate`` / ``plan`` /
``explain`` on top of the package engine.
"""

try:
    from yunohost.nostrhost.package_authoring import main
except ModuleNotFoundError:  # source checkout; Debian installs this below yunohost/
    from nostrhost.package_authoring import main


if __name__ == "__main__":
    raise SystemExit(main())