#!/usr/bin/env python3

import os as _os
import sys as _sys
from pathlib import Path as _Path

# Prefer the bundled runtime venv: the runtime's wheels (coincurve, ...) are
# only guaranteed inside /opt/nostrhost/venv; the system python is a fallback
# for nodes where the runtime has not been installed yet. The venv's python
# binary is a symlink to the system interpreter, so detect it via sys.prefix
# rather than the executable path.
_VENV = _Path("/opt/nostrhost/venv")
if (_VENV / "bin/python3").is_file() and _Path(_sys.prefix) != _VENV:
    _os.execv(str(_VENV / "bin/python3"), [str(_VENV / "bin/python3"), _sys.argv[0]] + _sys.argv[1:])


import os as _os
import sys as _sys
from pathlib import Path as _Path

# Prefer the bundled runtime venv: the runtime's wheels (coincurve, ...) are
# only guaranteed inside /opt/nostrhost/venv; the system python is a fallback
# for nodes where the runtime has not been installed yet.
_VENV_PY = _Path("/opt/nostrhost/venv/bin/python3")
if _VENV_PY.is_file() and _os.path.realpath(_sys.executable) != _os.path.realpath(str(_VENV_PY)):
    _os.execv(str(_VENV_PY), [str(_VENV_PY), _sys.argv[0]] + _sys.argv[1:])

"""Validate, plan, and migrate native NostrHost packages."""

import argparse
import json
from pathlib import Path

try:
    from yunohost.nostrhost.package_engine import PackageError, load_package, migrate_manifest_file, plan_package, schema
except ModuleNotFoundError:  # source checkout; Debian installs this below yunohost/
    from nostrhost.package_engine import PackageError, load_package, migrate_manifest_file, plan_package, schema


def main() -> int:
    parser = argparse.ArgumentParser(prog="nostrhost-package")
    sub = parser.add_subparsers(dest="command", required=True)
    plan_parser = sub.add_parser("plan")
    plan_parser.add_argument("package", type=Path)
    plan_parser.add_argument("--json", action="store_true", dest="as_json")
    schema_parser = sub.add_parser("schema")
    schema_parser.add_argument("--json", action="store_true", dest="as_json")
    migrate = sub.add_parser("migrate")
    migrate.add_argument("manifest", type=Path)
    migrate.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        if args.command == "schema":
            print(json.dumps(schema(), indent=2, sort_keys=True))
        elif args.command == "migrate":
            migrate_manifest_file(args.manifest, args.output)
        else:
            operations = [operation.json_dict() for operation in plan_package(load_package(args.package), template_root=args.package.parent)]
            if args.as_json:
                print(json.dumps(operations, indent=2, sort_keys=True, default=str))
            else:
                for index, operation in enumerate(operations, 1):
                    deps = f" (after {', '.join(operation['depends_on'])})" if operation["depends_on"] else ""
                    print(f"{index:02d} {operation['name']} {operation['resource']}: {operation['summary']}{deps}")
    except PackageError as exc:
        parser.error(str(exc))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
