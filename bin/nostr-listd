#!/usr/bin/env python3
"""nostr-listd — NIP-51/NIP-78 list and preference projector daemon.

Subscribes to the host's list/preference kinds (mute list, preferred/blocked
relays, people sets, application data) on the local control relay and folds
them into the list projection + family compatibility files. Config via
/etc/nostrhost/operator.toml or NOSTRHOST_* environment variables.
"""

from __future__ import annotations

import os as _os
import sys as _sys
from pathlib import Path as _Path

# Prefer the bundled runtime venv: the runtime's wheels (nostr-sdk, ...) are
# only guaranteed inside /opt/nostrhost/venv; the system python is a fallback
# for nodes where the runtime has not been installed yet.
_VENV_PY = _Path("/opt/nostrhost/venv/bin/python3")
if _VENV_PY.is_file() and _os.path.realpath(_sys.executable) != _os.path.realpath(str(_VENV_PY)):
    _os.execv(str(_VENV_PY), [str(_VENV_PY), _sys.argv[0]] + _sys.argv[1:])


import sys

from yunohost.nostr_listd import run

if __name__ == "__main__":
    sys.exit(run())
