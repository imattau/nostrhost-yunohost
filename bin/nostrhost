#!/usr/bin/env python3
"""nostrhost — native administration CLI.

Typer commands over the native NostrHost operation surface (system/service/
app/package/rollback/state tools, npub identity, capability); see
nostrhost.cli.  Supports --output-as json/plain/none.
"""

from __future__ import annotations

import os as _os
import sys as _sys
from pathlib import Path as _Path

# Prefer the bundled runtime venv: the runtime's wheels (coincurve, ...) are
# only guaranteed inside /opt/nostrhost/venv; the system python is a fallback
# for nodes where the runtime has not been installed yet.
_VENV_PY = _Path("/opt/nostrhost/venv/bin/python3")
if _VENV_PY.is_file() and _os.path.realpath(_sys.executable) != _os.path.realpath(str(_VENV_PY)):
    _os.execv(str(_VENV_PY), [str(_VENV_PY), _sys.argv[0]] + _sys.argv[1:])


import sys
from pathlib import Path

try:  # installed layout: yunohost is a real package
    import yunohost  # noqa: F401
except ImportError:  # source-tree layout: alias src/ as the yunohost package
    _src = Path(__file__).resolve().parent.parent / "src"
    if _src.is_dir():
        import types

        _pkg = types.ModuleType("yunohost")
        _pkg.__path__ = [str(_src)]  # type: ignore[attr-defined]
        sys.modules["yunohost"] = _pkg

from nostrhost.cli import main

if __name__ == "__main__":
    sys.exit(main())