[Unit]
Description=NostrHost permission-list projector (NIP-51 kind 30000 -> permission projection)
After=network-online.target nostrhost-control.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/nostrhost/venv/bin/python3 /usr/bin/nostr-permissiond
Restart=on-failure
RestartSec=5s
User=root
UMask=0077
RuntimeDirectory=nostrhost
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nostrhost /var/lib/nostrhost

[Install]
WantedBy=multi-user.target
