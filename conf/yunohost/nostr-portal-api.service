[Unit]
Description=NostrHost portal-api / authd (Caddy forward_auth + Nostr sign-in, 127.0.0.1:6788)
After=network-online.target nostrhost-control.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/nostrhost/venv/bin/python3 /usr/bin/nostr-portal-api --host 127.0.0.1 --port 6788
Restart=on-failure
RestartSec=5s
User=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nostrhost /var/lib/nostrhost

[Install]
WantedBy=multi-user.target