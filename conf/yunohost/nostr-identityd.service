[Unit]
Description=NostrHost identity projector (kind 31102 -> identity.db)
After=network-online.target nostrhost-control.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/nostrhost/venv/bin/python3 /usr/bin/nostr-identityd
Restart=on-failure
RestartSec=5s
User=root
UMask=0077
RuntimeDirectory=nostrhost
RuntimeDirectoryPreserve=yes
# Sandboxing hardening block: kept identical (module for module) across all
# nostr-*d.service units (ddnswatchd/securityd/permissiond/identityd/
# operationsd) -- change one, change them all. ProtectHome=true because this
# daemon never reads or writes anything under /home; nostr-operationsd is the
# one deliberate exception (ProtectHome=read-only, because it needs to write
# /home/yunohost.backup) -- see that unit's comment before assuming drift.
NoNewPrivileges=true
PrivateTmp=true
# Linking a new identity (kind-31102) makes this daemon call
# yunohost.user.user_create directly (YnhAccountBackend.ensure_user), which
# shells out to useradd -m -- the same shadow-utils lock + /home homedir
# write this fork's other account-creating daemons need. ProtectSystem=full/
# ProtectHome=true are intentionally NOT set here, for the same reason and
# verified the same way as nostr-api.service/nostr-operationsd.service: even
# with these exact paths re-granted via ReadWritePaths, useradd's lock on
# /etc/passwd and the /home homedir creation both still fail under Protect*
# on this systemd/kernel combination ("useradd: cannot lock /etc/passwd").
ReadWritePaths=/etc/nostrhost /var/lib/nostrhost

[Install]
WantedBy=multi-user.target