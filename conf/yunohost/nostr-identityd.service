[Unit]
Description=NostrHost identity projector (kind 31102 -> identity.db)
After=network-online.target nostrhost-control.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/nostrhost/venv/bin/python3 /usr/bin/nostr-identityd
Restart=on-failure
RestartSec=5s
User=root
UMask=0077
RuntimeDirectory=nostrhost
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nostrhost /var/lib/nostrhost /run/nostrhost

[Install]
WantedBy=multi-user.target