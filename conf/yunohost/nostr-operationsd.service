[Unit]
Description=NostrHost operation executor (2200-2204 chain)
After=network-online.target nostrhost-control.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/nostrhost/venv/bin/python3 /usr/bin/nostr-operationsd
Restart=on-failure
RestartSec=5s
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nostrhost /var/lib/nostrhost

[Install]
WantedBy=multi-user.target