[Unit]
Description=NostrHost CrowdSec security projector (kind 2213)
After=network-online.target nostrhost-control.service crowdsec.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/nostrhost/venv/bin/python3 /usr/bin/nostr-securityd
Restart=on-failure
RestartSec=5s
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nostrhost /var/lib/nostrhost

[Install]
WantedBy=multi-user.target