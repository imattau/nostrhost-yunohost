# Opt-in NostrHost/YunoHost application authentication bridge.
# Include this from an application's protected location.
# The exact internal endpoint is defined in yunohost_api.conf.inc.
auth_request /yunohost/portalapi/nostr/auth-request;

# Copy identity returned by the auth subrequest to the application request.
auth_request_set $nostrhost_remote_user $upstream_http_x_remote_user;
auth_request_set $nostrhost_remote_email $upstream_http_x_remote_email;
auth_request_set $nostrhost_remote_fullname $upstream_http_x_remote_fullname;
auth_request_set $nostrhost_pubkey $upstream_http_x_nostr_pubkey;
auth_request_set $nostrhost_npub $upstream_http_x_nostr_npub;

# Do not trust client-supplied copies of these headers.
proxy_set_header X-Remote-User $nostrhost_remote_user;
proxy_set_header X-Remote-Email $nostrhost_remote_email;
proxy_set_header X-Remote-Fullname $nostrhost_remote_fullname;
proxy_set_header X-Nostr-Pubkey $nostrhost_pubkey;
proxy_set_header X-Nostr-Npub $nostrhost_npub;
