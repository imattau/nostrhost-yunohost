# Base Caddyfile tracked by regenconf (category: caddy).
#
# Global options apply to every site (regenconf-tracked domain snippets in
# /etc/caddy/conf.d/ and native `web.route` admin-API routes).
{
	admin 127.0.0.1:2019
	http_port 80
	https_port 443
	storage file_system {
		root /var/lib/caddy
	}

	# Access log for every request. `format json` is Caddy's default and is
	# what CrowdSec's `crowdsecurity/caddy-logs` parser consumes for web-layer
	# auth-failure detection (see docs/CROWDSEC-MIGRATION.md §8.3). Each site
	# block enables request logging with a bare `log` directive (see
	# caddy_domain.conf); `include http.log.access` routes every site's access
	# logger to this one file.
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
		include http.log.access
	}

	# On-Demand TLS for the nsite gateway origin (D2): before issuing any
	# per-label certificate Caddy asks the gateway's loopback-only
	# /internal/tls-ask endpoint, which answers 200 only for labels that
	# decode and are allowlisted. With the gateway stopped the endpoint is
	# unreachable and issuance is refused (safe failure). Only sites using
	# `tls { on_demand }` (caddy_nsite.conf) are affected; normal domains
	# keep their configured ACME/internal TLS.
	on_demand_tls {
		ask http://127.0.0.1:8196/internal/tls-ask
	}
}

# Per-domain tracked snippets (regenconf renders /etc/caddy/conf.d/*.conf).
import /etc/caddy/conf.d/*.conf
