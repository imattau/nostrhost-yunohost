set -e

# Diagnostic breadcrumb only (no side effects): marks the moment dpkg is
# about to unpack this package's new files, i.e. right before the window in
# which nostr-operationsd has been observed being stopped mid-transaction
# (see debian/rules' override_dh_installsystemd for the synchronous-restart
# issue this does NOT cover -- that failure happens here, during unpack,
# before any maintainer script from the new version has run).
logger -t nostrhost-core.preinst "preinst $1: about to unpack (pid $$)" || true

exit 0
